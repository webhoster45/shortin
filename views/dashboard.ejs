<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
  <title>Shortin - Redis Edge URL Shortener</title>

  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
  <script src="https://cdn.tailwindcss.com"></script>
  <script id="tailwind-config">
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            "inverse-primary": "#c0c1ff",
            "on-secondary-container": "#fffbff",
            "on-primary": "#ffffff",
            "secondary": "#6b38d4",
            "surface-variant": "#dae2fd",
            "on-surface": "#131b2e",
            "secondary-container": "#8455ef",
            "primary-fixed-dim": "#c0c1ff",
            "on-secondary-fixed": "#23005c",
            "tertiary-fixed": "#acedff",
            "outline": "#767586",
            "tertiary-container": "#008096",
            "on-error-container": "#93000a",
            "background": "#faf8ff",
            "on-background": "#131b2e",
            "on-secondary": "#ffffff",
            "surface-container-highest": "#dae2fd",
            "surface-dim": "#d2d9f4",
            "inverse-surface": "#283044",
            "surface-container-lowest": "#ffffff",
            "on-tertiary-fixed": "#001f26",
            "primary-container": "#6063ee",
            "error-container": "#ffdad6",
            "on-primary-container": "#fffbff",
            "tertiary": "#006577",
            "surface-tint": "#494bd6",
            "outline-variant": "#c7c4d7",
            "tertiary-fixed-dim": "#4cd7f6",
            "surface-container-low": "#f2f3ff",
            "primary": "#4648d4",
            "secondary-fixed": "#e9ddff",
            "on-tertiary": "#ffffff",
            "on-primary-fixed-variant": "#2f2ebe",
            "on-secondary-fixed-variant": "#5516be",
            "primary-fixed": "#e1e0ff",
            "surface-bright": "#faf8ff",
            "on-tertiary-fixed-variant": "#004e5c",
            "on-tertiary-container": "#f9fdff",
            "inverse-on-surface": "#eef0ff",
            "on-error": "#ffffff",
            "surface": "#faf8ff",
            "surface-container-high": "#e2e7ff",
            "surface-container": "#eaedff",
            "secondary-fixed-dim": "#d0bcff",
            "on-primary-fixed": "#07006c",
            "error": "#ba1a1a",
            "on-surface-variant": "#464554"
          }
        }
      }
    }
  </script>
  <style>
    @layer base {
      html, body { margin: 0; padding: 0; }
      body { overscroll-behavior: none; }
    }
    ::-webkit-scrollbar { display: none; }
  </style>
</head>
<body class="bg-surface font-body-md text-on-surface antialiased">
  <!-- Header -->
  <header class="fixed top-0 w-full z-50 bg-surface/80 backdrop-blur-xl shadow-[0_1px_8px_rgba(0,0,0,0.04)]">
    <div class="h-16 max-w-7xl mx-auto px-6 flex items-center justify-between gap-4">
      <div class="flex items-center gap-4">
        <div class="flex items-center gap-2">
          <span class="font-semibold tracking-tight text-on-surface text-lg">Shortin</span>
          <span class="px-2 py-0.5 rounded-full bg-secondary-fixed text-on-secondary-fixed-variant text-xs uppercase font-semibold">v0.4</span>
        </div>
        <nav class="hidden md:flex items-center gap-1">
          <a class="px-4 py-2 bg-primary-container text-on-primary-container font-medium rounded-lg" href="#">Features</a>
          <a class="px-4 py-2 rounded-lg text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high transition-colors" href="#">My Links</a>
          <a class="px-4 py-2 rounded-lg text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high transition-colors" href="#">Analytics</a>
          <a class="px-4 py-2 rounded-lg text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high transition-colors" href="#">Pricing</a>
          <a class="px-4 py-2 rounded-lg text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high transition-colors" href="#">API</a>
        </nav>
      </div>
      <div class="flex items-center gap-2">
        <button class="w-8 h-8 rounded-lg flex items-center justify-center text-on-surface-variant hover:text-on-surface hover:bg-surface-container transition-colors" type="button">
          <!-- <span class="material-symbols-outlined text-[20px]">dark_mode</span> -->
        </button>
        <!-- <a class="hidden sm:inline-flex items-center px-4 py-2 rounded-lg text-on-surface-variant hover:text-on-surface hover:bg-surface-container transition-colors" href="#">Sign In</a>
        <a class="inline-flex items-center px-4 py-2 rounded-lg bg-gradient-to-r from-primary to-secondary text-on-primary shadow-sm hover:opacity-95 transition-all" href="#">Get Started</a> -->
        <div class="w-8 h-8 rounded-full bg-primary flex items-center justify-center ml-1">
          <span class="material-symbols-outlined text-on-primary text-[18px]">person</span> <%= username %>
        </div>
      </div>
    </div>
  </header>

  <!-- Main Content -->
  <main class="w-full pt-16 bg-surface">
    <div class="relative w-full overflow-hidden">
      <!-- Glow Effects -->
      <div class="absolute top-0 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[820px] h-[460px] bg-gradient-to-tr from-primary-fixed/40 via-secondary-fixed/30 to-tertiary-fixed/20 blur-[120px] rounded-full pointer-events-none -z-10"></div>
      
      <div class="max-w-6xl mx-auto px-6 py-12">
        <!-- Hero Section -->
        <div class="text-center max-w-3xl mx-auto flex flex-col items-center">
          <div class="inline-flex items-center gap-2 px-4 py-1 rounded-full bg-surface-container-high/70 backdrop-blur-md shadow-sm border border-outline-variant/30 mb-4">
            <span class="inline-block w-2 h-2 rounded-full bg-primary animate-pulse"></span>
            <span class="text-xs text-on-surface-variant uppercase tracking-wider font-semibold">⚡ Powered by Redis Edge Architecture</span>
          </div>
          <h1 class="text-4xl md:text-[3rem] font-bold text-on-surface tracking-tight leading-[1.12]">
            Supercharge your links with <span class="bg-gradient-to-r from-primary via-secondary to-secondary-container bg-clip-text text-transparent">sub-millisecond</span> redirects.
          </h1>
          <p class="text-body-lg text-on-surface-variant mt-4 max-w-2xl text-center">
            Ultra-low latency URL shortening backed by distributed memory caches. Instant vanity aliases, deterministic TTL expiration, and privacy analytics.
          </p>
        </div>

        <form>x
        <!-- Shortener Form Card -->
        <div class="mt-12 max-w-3xl mx-auto">
          <div class="bg-surface-container-lowest/90 backdrop-blur-xl rounded-2xl shadow-[0_18px_60px_-15px_rgba(70,72,212,0.12)] p-4 sm:p-6 border border-outline-variant/40">
            <form action="/shorten" method="POST" class="space-y-4" id="shorten-form" onsubmit="event.preventDefault();">
              <div class="relative flex flex-col sm:flex-row items-stretch sm:items-center gap-2 bg-surface-container-low/70 rounded-xl p-1.5 focus-within:ring-2 focus-within:ring-primary/40 transition-all">
                <div class="flex items-center gap-2 pl-3 py-1 flex-1 min-w-0">
                  <span class="material-symbols-outlined text-primary text-[22px] shrink-0">link</span>
                  <input class="w-full bg-transparent border-none text-on-surface placeholder:text-outline focus:outline-none truncate" id="target-url-input" oninput="handleUrlInput(this.value)" placeholder="Paste a long link... (e.g. https://my-product.com)" required type="url" value="https://acmeproducts.com/deals/summer-launch-sale-tracker-2025"/>
                </div>
                <div class="hidden sm:flex items-center gap-1 px-2.5 py-1 rounded-full bg-surface-container-highest text-primary text-xs shrink-0" id="url-badge">
                  <span class="material-symbols-outlined text-[16px]">check_circle</span>
                  <span>Valid link</span>
                </div>
                <button class="px-6 py-3 rounded-lg bg-gradient-to-r from-primary to-secondary text-on-primary font-medium shadow-md hover:opacity-95 transition-all flex items-center justify-center gap-2 shrink-0 group" id="shorten-btn" type="submit">
                  <span id="btn-text">Shorten Link</span>
                  <span class="material-symbols-outlined text-[18px] group-hover:translate-x-0.5 transition-transform" id="btn-icon">bolt</span>
                  <svg class="hidden animate-spin h-5 w-5 text-white" fill="none" id="btn-spinner" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z" fill="currentColor"></path>
                  </svg>
                </button>
             
              <!-- Magic Options Trigger -->
              <div class="flex items-center justify-between pt-1">
                <button class="flex items-center gap-1.5 text-on-surface-variant hover:text-primary transition-colors text-xs group" onclick="toggleMagicOptions()" type="button">
                  <span class="material-symbols-outlined text-[18px] text-secondary group-hover:rotate-45 transition-transform">auto_fix_high</span>
                  <span class="font-medium">Link Magic &amp; Options</span>
                  <span class="material-symbols-outlined text-[16px] transition-transform" id="magic-caret">expand_more</span>
                </button>
              </div>

              <!-- Magic Options Drawer -->
              <div class="hidden flex-col gap-4 pt-4 border-t border-surface-container-high" id="magic-options">
                <div class="flex flex-col sm:flex-row gap-4 sm:items-center justify-between"> 
                  <div class="flex-1">
                    <label class="block text-xs font-semibold text-on-surface mb-1">Custom Backhalf Alias</label>
                    <div class="flex items-center rounded-lg bg-surface-container-low px-3 py-2 border border-outline-variant/30 focus-within:border-primary">
                      <span class="text-xs text-on-surface-variant select-none">shortin.io/</span>
                      <input class="bg-transparent border-none text-xs text-on-surface p-0 focus:outline-none flex-1 ml-1 font-mono" id="custom-alias" type="text" value="summer-sale"/>
                      <span class="flex items-center gap-1 text-emerald-600 text-xs uppercase bg-emerald-50 px-2 py-0.5 rounded">
                        <span class="material-symbols-outlined text-[14px]">check</span> Available
                      </span>
                    </div>
                  </div>
                </div>
              </div>
            </form>
          </div>
        </div>

        <!-- Result Card -->
        <div class="mt-8 max-w-3xl mx-auto transition-all duration-500" id="result-card">
          <div class="relative overflow-hidden bg-gradient-to-br from-surface-container-lowest via-surface-container-lowest to-surface-container-low rounded-2xl p-6 shadow-xl border border-primary-fixed-dim/50">
            <div class="flex flex-wrap items-center justify-between gap-4 pb-4 border-b border-surface-container-high">
              <div class="flex items-center gap-2">
                <span class="px-2.5 py-1 rounded-full bg-secondary-fixed text-on-secondary-fixed text-xs uppercase flex items-center gap-1 font-semibold">
                  <span class="material-symbols-outlined text-[14px]">auto_awesome</span> Link Ready!
                </span>
                <span class="text-outline">•</span>
                <span class="text-xs text-on-surface-variant">Generated in <strong>14ms</strong></span>
              </div>
              <div class="flex items-center gap-2 px-3 py-1 rounded-full bg-error-container/40 text-on-surface text-xs font-mono">
                <span>Self-destructing in <strong class="text-on-error-container" id="live-countdown">6d 23h 59m 44s</strong></span>
              </div>
            </div>
            
            <div class="py-6 flex flex-col md:flex-row md:items-center justify-between gap-4">
              <div class="min-w-0">
                <div class="flex items-center gap-2">
                  <span class="text-xl font-bold tracking-tight text-primary hover:underline cursor-pointer">
                    shortin.io/<span id="result-slug">summer-sale</span>
                  </span>
                  <span class="px-2 py-0.5 rounded bg-surface-container-high text-on-surface text-xs">301 Redirect</span>
                </div>
                <p class="text-xs text-on-surface-variant truncate max-w-md mt-1 flex items-center gap-1">
                  <span class="material-symbols-outlined text-[14px]">arrow_forward</span>
                  <span id="result-long-url">https://acmeproducts.com/deals/summer-launch-sale-tracker-2025</span>
                </p>
              </div>
              <div class="flex items-center gap-2 shrink-0">
                <button class="px-6 py-3 rounded-xl bg-primary text-on-primary font-medium shadow-md hover:bg-primary-container transition-all flex items-center gap-2" id="copy-link-btn" onclick="copyShortUrl(this, 'https://shortin.io/summer-sale')">
                  <span class="material-symbols-outlined text-[18px]">content_copy</span>
                  <span class="copy-text">Copy Short Link</span>
                </button>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </main>

  <!-- Footer -->
  <footer class="w-full bg-surface-container-low mt-16 border-t border-surface-container-high">
    <div class="max-w-7xl mx-auto px-6 py-8 flex flex-col md:flex-row items-center justify-between gap-4 text-on-surface-variant text-sm">
      <div class="flex items-center gap-2">
        <span class="font-semibold text-on-surface">Shortin</span>
        <span>© 2026 Shortin Inc. All rights reserved.</span>
      </div>

    </div>
  </footer>

  <!-- Clean Script Logic -->
  <script>
    function triggerShorten() {
      const input = document.getElementById('target-url-input');
      const btn = document.getElementById('shorten-btn');
      const btnText = document.getElementById('btn-text');
      const btnIcon = document.getElementById('btn-icon');
      const btnSpinner = document.getElementById('btn-spinner');
      const resultCard = document.getElementById('result-card');
      const resultSlug = document.getElementById('result-slug');
      const resultLong = document.getElementById('result-long-url');
      const customAlias = document.getElementById('custom-alias').value.trim();

      if (!input.value) return;

      btnText.innerText = 'Compressing...';
      btnIcon.classList.add('hidden');
      btnSpinner.classList.remove('hidden');
      btn.disabled = true;

      setTimeout(() => {
        btnText.innerText = 'Shorten Link';
        btnIcon.classList.remove('hidden');
        btnSpinner.classList.add('hidden');
        btn.disabled = false;

        const finalSlug = customAlias || 'link-' + Math.random().toString(36).substring(2, 7);
        resultSlug.innerText = finalSlug;
        resultLong.innerText = input.value;

        const copyBtn = document.getElementById('copy-link-btn');
        copyBtn.setAttribute('onclick', `copyShortUrl(this, 'https://shortin.io/${finalSlug}')`);

        resultCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }, 650);
    }

    function handleUrlInput(value) {
      const badge = document.getElementById('url-badge');
      if (value.startsWith('http://') || value.startsWith('https://')) {
        badge.classList.remove('hidden');
      } else {
        badge.classList.add('hidden');
      }
    }

    function toggleMagicOptions() {
      const drawer = document.getElementById('magic-options');
      const caret = document.getElementById('magic-caret');
      if (drawer.classList.contains('hidden')) {
        drawer.classList.remove('hidden');
        drawer.classList.add('flex');
        caret.classList.add('rotate-180');
      } else {
        drawer.classList.add('hidden');
        drawer.classList.remove('flex');
        caret.classList.remove('rotate-180');
      }
    }

    function copyShortUrl(btnElement, textToCopy) {
      navigator.clipboard.writeText(textToCopy).then(() => {
        const textSpan = btnElement.querySelector('.copy-text');
        const iconSpan = btnElement.querySelector('.material-symbols-outlined');
        const originalText = textSpan ? textSpan.innerText : '';
        const originalIcon = iconSpan ? iconSpan.innerText : '';

        if (textSpan) textSpan.innerText = 'Copied!';
        if (iconSpan) iconSpan.innerText = 'done';
        
        btnElement.classList.add('bg-emerald-600', 'text-white');

        setTimeout(() => {
          if (textSpan) textSpan.innerText = originalText;
          if (iconSpan) iconSpan.innerText = originalIcon;
          btnElement.classList.remove('bg-emerald-600', 'text-white');
        }, 1800);
      });
    }

    // Live Countdown Clock Decrementor
    let totalSeconds = (6 * 86400) + (23 * 3600) + (59 * 60) + 44;
    setInterval(() => {
      totalSeconds--;
      if (totalSeconds > 0) {
        const d = Math.floor(totalSeconds / (3600*24));
        const h = Math.floor((totalSeconds % (3600*24)) / 3600);
        const m = Math.floor((totalSeconds % 3600) / 60);
        const s = Math.floor(totalSeconds % 60);
        const clockEl = document.getElementById('live-countdown');
        if (clockEl) {
          clockEl.innerText = `${d}d ${h}h ${m}m ${s}s`;
        }
      }
    }, 1000);
  </script>
</body>
</html>