            <span class="material-symbols-outlined text-[14px]">arrow_forward</span>
            <span id="result-long-url"><%= shortcode.original_url %></span>
          </p>
        </div>
        <div class="flex items-center gap-2 shrink-0">
<!-- Inside your loop, update the actions button area to match this -->
<div class="flex items-center gap-2 shrink-0">
  <!-- NEW: Analytics trigger button -->
  <button class="px-4 py-3 rounded-xl bg-surface-container-high text-on-surface hover:bg-surface-container-highest transition-all flex items-center gap-2 font-medium text-sm border border-outline-variant/30" onclick="openAnalyticsModal('<%= shortcode.shortcode %>')">
