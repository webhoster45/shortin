        </div>

        
        <!-- Shortener Form Card -->
<!-- Shortener Form Card (Fixed structure) -->
<div class="mt-12 max-w-3xl mx-auto">
  <div class="bg-surface-container-lowest/90 backdrop-blur-xl rounded-2xl shadow-[0_18px_60px_-15px_rgba(70,72,212,0.12)] p-4 sm:p-6 border border-outline-variant/40">
    
    <!-- FIX: Removed outer form loop and dropped preventDefault() to allow natural redirection -->
    <form action="/shorten" method="POST" class="space-y-4" id="shorten-form">
      <div class="relative flex flex-col sm:flex-row items-stretch sm:items-center gap-2 bg-surface-container-low/70 rounded-xl p-1.5 focus-within:ring-2 focus-within:ring-primary/40 transition-all">
        <div class="flex items-center gap-2 pl-3 py-1 flex-1 min-w-0">
          <span class="material-symbols-outlined text-primary text-[22px] shrink-0">link</span>
          <input class="w-full bg-transparent border-none text-on-surface placeholder:text-outline focus:outline-none truncate" id="target-url-input" name="original_url" oninput="handleUrlInput(this.value)" placeholder="Paste a long link... (e.g. https://my-product.com)" required type="url" />
        </div>
        
        <button class="px-6 py-3 rounded-lg bg-gradient-to-r from-primary to-secondary text-on-primary font-medium shadow-md hover:opacity-95 transition-all flex items-center justify-center gap-2 shrink-0 group" id="shorten-btn" type="submit">
          <span id="btn-text">Shorten Link</span>
          <span class="material-symbols-outlined text-[18px] group-hover:translate-x-0.5 transition-transform" id="btn-icon">bolt</span>
        </button>
      </div>
     
      <!-- Magic Options Trigger -->
      <div class="flex items-center justify-between pt-1">
        <button class="flex items-center gap-1.5 text-on-surface-variant hover:text-primary transition-colors text-xs group" onclick="toggleMagicOptions()" type="button">
          <span class="material-symbols-outlined text-[18px] text-secondary group-hover:rotate-45 transition-transform">auto_fix_high</span>
          <span class="font-medium">Link Magic &amp; Options</span>
          <span class="material-symbols-outlined text-[16px] transition-transform" id="magic-caret">expand_more</span>
        </button>
      </div>

      <!-- Magic Options Drawer -->
      <div class="hidden flex-col gap-4 pt-4 border-t border-surface-container-high" id="magic-options">
        <div class="flex flex-col sm:flex-row gap-4 sm:items-center justify-between"> 
          <div class="flex-1">
            <label class="block text-xs font-semibold text-on-surface mb-1">Custom Backhalf Alias</label>
            <div class="flex items-center rounded-lg bg-surface-container-low px-3 py-2 border border-outline-variant/30 focus-within:border-primary">
              <input type="hidden" id="hidden-input" name="domainname" required value="http://localhost:3000">
              <span class="text-xs text-on-surface-variant select-none">localhost:3000/</span>
              <input class="bg-transparent border-none text-xs text-on-surface p-0 focus:outline-none flex-1 ml-1 font-mono" id="custom-alias" name="choice" type="text" placeholder="Customize a url!"/>
              <span class="flex items-center gap-1 text-emerald-600 text-xs uppercase bg-emerald-50 px-2 py-0.5 rounded">
                <span class="material-symbols-outlined text-[14px]">check</span> Available
              </span>
            </div>
          </div>
        </div>
      </div>
    </form>
    
  </div>
</div>


        <!-- Result Card -->
  <% if (shortcodes.length < 0) {%>
    <p>Shortcode doesn't exist</p>
    <% } %>
<% shortcodes.forEach(shortcode => { %>
  <div class="mt-8 max-w-3xl mx-auto transition-all duration-500" id="result-card">
    <div class="relative overflow-hidden bg-gradient-to-br from-surface-container-lowest via-surface-container-lowest to-surface-container-low rounded-2xl p-6 shadow-xl border border-primary-fixed-dim/50">
      <div class="flex flex-wrap items-center justify-between gap-4 pb-4 border-b border-surface-container-high">
        <div class="flex items-center gap-2">
          <span class="px-2.5 py-1 rounded-full bg-secondary-fixed text-on-secondary-fixed text-xs uppercase flex items-center gap-1 font-semibold">
            <span class="material-symbols-outlined text-[14px]">auto_awesome</span> Link Ready!
