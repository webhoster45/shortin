  <!-- Clean Script Logic -->
  <script>

    document.addEventListener('DOMContentLoaded', () => {
    // 1. Format all timestamps safely on render mount
    document.querySelectorAll('.expiry-date-display').forEach(el => {
      const isostring = el.getAttribute('data-iso');
      if (isostring) {
        const localdate = new Date(isostring);
        el.innerText = localdate.toLocaleString(undefined, {
          month: 'short',
          day: 'numeric',
          year: 'numeric',
          hour: '2-digit',
          minute: '2-digit',
          second: '2-digit'
        });
      }
    });

    // 2. Open Real-Time SSE Stream pipeline connection channel
    console.log("📡 Connecting to live event streaming service...");
    const eventSource = new EventSource('/stream');

    eventSource.onmessage = (event) => {
      try {
        const data = JSON.parse(event.data);
        console.log("⚡ Live tracking metric received:", data);

        // Spawn an elegant floating action banner toast message notification immediately
        showLiveToast(data.shortcode, data.query, data.eventtype);
      } catch (err) {
        console.error("Failed to parse incoming stream data chunk:", err);
      }
    };

    eventSource.onerror = (err) => {
      console.error("SSE connection hitch. Client auto-reconnecting...", err);
    };
  });

  document.getElementById('shorten-form').addEventListener('submit', async (event) => {
    event.preventDefault();
    const form = event.currentTarget;
    const submitButton = form.querySelector('[type="submit"]');
    const feedback = document.getElementById('shorten-feedback');
    feedback.classList.add('hidden');
    submitButton.disabled = true;
    try {
      const createResponse = await fetch('/shorten', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { Accept: 'application/json' },
        body: new FormData(form)
      });
      const created = await createResponse.json().catch(() => ({}));
      if (!createResponse.ok || !created.success) throw new Error(created.message || 'Could not create the short link.');

      const eventResponse = await fetch('/event', {
        method: 'POST',
        credentials: 'same-origin',
        headers: {
          'Content-Type': 'application/json',
          Accept: 'application/json',
          'Idempotency-Key': crypto.randomUUID()
        },
        body: JSON.stringify({
          eventtype: 'shortcodes',
          shortcode: created.shortcode,
          query: 'created'
        })
      });
      const eventResult = await eventResponse.json().catch(() => ({}));
      if (!eventResponse.ok || !eventResult.success) {
        feedback.textContent = `/${created.shortcode} was created, but its activity event could not be recorded: ${eventResult.message || 'please try again'}`;
        feedback.classList.remove('hidden');
        return;
      }
      window.location.assign('/dashboard');
    } catch (error) {
      feedback.textContent = error.message || 'Something went wrong while creating the link.';
      feedback.classList.remove('hidden');
    } finally {
      submitButton.disabled = false;
    }
  });

  // Fetch data cleanly from our fixed /analytics/overview backend route
  function openAnalyticsModal(shortcode) {
    const modal = document.getElementById('analytics-modal');
    document.getElementById('modal-target-slug').innerText = `/${shortcode}`;

    // Set initial loading placeholders
    document.getElementById('stat-clicks').innerText = "...";
    document.getElementById('stat-active').innerText = "...";
    document.getElementById('stat-visits').innerText = "...";
    document.getElementById('stat-rank').innerText = "...";
    document.getElementById('stat-score').innerText = "...";
    document.getElementById('stat-cache-status').innerText = "Fetching telemetry data...";

    modal.classList.remove('hidden');
    modal.classList.add('flex');

    fetch('/analytics/overview', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ shortcode })
    })
    .then(async res => {
      const data = await res.json();
      if (!res.ok || !data.success) throw new Error(data.message || 'Failed to fetch analytics.');
      return data.redis;
    })
    .then(redis => {
      document.getElementById('stat-clicks').innerText = redis.clickCount;
      document.getElementById('stat-active').innerText = redis.activeUsersLast5Minutes;
      document.getElementById('stat-visits').innerText = redis.redirectVisitsLastFiveMinutes;
      document.getElementById('stat-rank').innerText = redis.clickLeaderboardRank ?? 'Unranked';
      document.getElementById('stat-score').innerText = redis.clickLeaderboardScore;
      document.getElementById('stat-code-record').textContent = redis.shortCodeRecord ?? 'Missing or expired';
      document.getElementById('stat-cache-payload').textContent = redis.redirectCachePayload ?? 'No redirect destination cached';
      document.getElementById('stat-event-cache').textContent = redis.eventCachePayload ?? 'No event cache result';
      document.getElementById('stat-activity').textContent = redis.activity.length
        ? redis.activity.join('\n')
        : 'No activity recorded today.';

      const cacheEl = document.getElementById('stat-cache-status');
      const iconEl = document.getElementById('stat-cache-icon');
      cacheEl.innerText = redis.redirectCachePresent ? 'Redirect destination is cached' : 'Redirect destination is not cached';
      cacheEl.className = redis.redirectCachePresent
        ? 'text-sm font-semibold text-emerald-600 mt-0.5'
        : 'text-sm font-semibold text-amber-600 mt-0.5';
      iconEl.className = redis.redirectCachePresent
        ? 'material-symbols-outlined text-emerald-500 animate-pulse'
        : 'material-symbols-outlined text-amber-500';
    })
    .catch(err => {
      console.error("Error loading shortcode metrics:", err);
      document.getElementById('stat-cache-status').innerText = err.message || 'Failed to load analytics.';
    });
  }

  function closeAnalyticsModal() {
    document.getElementById('analytics-modal').classList.add('hidden');
  }

  function showLiveToast(shortcode, query, eventtype) {
    const container = document.getElementById('toast-container');
    const toast = document.createElement('div');
    toast.className = "bg-inverse-surface text-inverse-on-surface p-4 rounded-xl shadow-2xl border border-outline/20 flex items-start gap-3 transform translate-y-4 opacity-0 transition-all duration-300 ease-out";

    const icon = document.createElement('span');
    icon.className = 'material-symbols-outlined text-tertiary-fixed-dim shrink-0 animate-bounce';
    icon.textContent = 'bolt';
    const content = document.createElement('div');
    content.className = 'flex-1 min-w-0';
    const title = document.createElement('p');
    title.className = 'text-xs font-bold uppercase tracking-wider text-primary-fixed-dim';
    title.textContent = eventtype === 'shortcodes' ? 'Short link created' : 'Link activity';
    const visit = document.createElement('p');
    visit.className = 'text-sm font-medium truncate mt-0.5';
    visit.textContent = `/${shortcode || ''} · ${query || 'activity recorded'}`;
    const details = document.createElement('p');
    details.className = 'text-xs text-outline-variant truncate mt-0.5';
    details.textContent = `Event: ${eventtype || 'unknown'}`;
    content.append(title, visit, details);
    toast.append(icon, content);

    container.appendChild(toast);
    setTimeout(() => { toast.classList.remove('translate-y-4', 'opacity-0'); }, 10);
    setTimeout(() => {
      toast.classList.add('opacity-0', 'translate-y-2');
      setTimeout(() => { toast.remove(); }, 300);
    }, 4500);
  }

  function toggleMagicOptions() {
    const drawer = document.getElementById('magic-options');
    const caret = document.getElementById('magic-caret');
    if (drawer.classList.contains('hidden')) {
      drawer.classList.remove('hidden');
      drawer.classList.add('flex');
      caret.classList.add('rotate-180');
    } else {
      drawer.classList.add('hidden');
      drawer.classList.remove('flex');
      caret.classList.remove('rotate-180');
    }
  }

  function copyShortUrl(btnElement, textToCopy) {
    navigator.clipboard.writeText(textToCopy).then(() => {
      const textSpan = btnElement.querySelector('.copy-text');
      if (textSpan) textSpan.innerText = 'Copied!';
      btnElement.classList.add('bg-emerald-600', 'text-white');
      setTimeout(() => {
        if (textSpan) textSpan.innerText = 'Copy';
        btnElement.classList.remove('bg-emerald-600', 'text-white');
      }, 1800);
    });
  }

  </script>
</body>
</html>
