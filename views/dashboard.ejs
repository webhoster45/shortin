          <span>Self-destructing in <strong class="text-on-error-container expiry-date-display" id="live-countdown" data-iso="<%= shortcode.expiry %>">Loading</strong></span>
        </div>
      </div>
      
      <div class="py-6 flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div class="min-w-0">
