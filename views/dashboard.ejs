        <p class="inline-flex items-center px-4 py-2 rounded-lg bg-gradient-to-r from-primary to-secondary text-on-primary shadow-sm hover:opacity-95 transition-all" href="#">Hello , <%= username %></p>
        <div class="w-8 h-8 rounded-full bg-primary flex items-center justify-center ml-1">

