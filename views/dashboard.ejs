  <!-- Clean Script Logic -->
  <script>

   document.addEventListener('DOMContentLoaded',()=>{
      document.querySelectorAll('.expiry-date-display').forEach(el=>{
        const isostring=el.getAttribute('data-iso');
        if(isostring){
          const localdate=new Date(isostring);

          el.innerText=localdate.toLocaleString(undefined,{
            month:'short',
            day: 'numeric',
            year: 'numeric',
            hour: '2-digit',
            minute:'2-digit',
            second:'2-digit'
          })
        }
      });

      console.log("Connecting to live event streaming service...");
      const eventsource=new EventSource('/stream');

      eventsource.onmessage=(event)=>{
        try{
        const data=JSON.parse(event.data);
        console.log("Live tracking metric recieved",data);

        showLiveToast(data.shortcode,data.query);

        }catch(err){
          console.error("Failed to parse incoming stream data chunk")
        }
      };

      eventsource.onerror=(err)=>{
        console.error("SSE connection hitch",err)
      }
   })



    function triggerShorten() {
      const input = document.getElementById('target-url-input');
      const btn = document.getElementById('shorten-btn');
      const btnText = document.getElementById('btn-text');
      const btnIcon = document.getElementById('btn-icon');
      const btnSpinner = document.getElementById('btn-spinner');
      const resultCard = document.getElementById('result-card');
      const resultSlug = document.getElementById('result-slug');
      const resultLong = document.getElementById('result-long-url');
      const customAlias = document.getElementById('custom-alias').value.trim();

      if (!input.value) return;

      btnText.innerText = 'Compressing...';
      btnIcon.classList.add('hidden');
      btnSpinner.classList.remove('hidden');
      btn.disabled = true;

      setTimeout(() => {
        btnText.innerText = 'Shorten Link';
        btnIcon.classList.remove('hidden');
        btnSpinner.classList.add('hidden');
        btn.disabled = false;

        const finalSlug = customAlias || 'link-' + Math.random().toString(36).substring(2, 7);
        resultSlug.innerText = finalSlug;
        resultLong.innerText = input.value;

        const copyBtn = document.getElementById('copy-link-btn');
        copyBtn.setAttribute('onclick', `copyShortUrl(this, 'https://shortin.io/${finalSlug}')`);

        resultCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }, 650);
    }

    function handleUrlInput(value) {
      const badge = document.getElementById('url-badge');
      if (value.startsWith('http://') || value.startsWith('https://')) {
        badge.classList.remove('hidden');
      } else {
        badge.classList.add('hidden');
      }
    }

    function toggleMagicOptions() {
      const drawer = document.getElementById('magic-options');
      const caret = document.getElementById('magic-caret');
      if (drawer.classList.contains('hidden')) {
        drawer.classList.remove('hidden');
        drawer.classList.add('flex');
        caret.classList.add('rotate-180');
      } else {
        drawer.classList.add('hidden');
        drawer.classList.remove('flex');
        caret.classList.remove('rotate-180');
      }
    }

    function copyShortUrl(btnElement, textToCopy) {
      navigator.clipboard.writeText(textToCopy).then(() => {
        const textSpan = btnElement.querySelector('.copy-text');
        const iconSpan = btnElement.querySelector('.material-symbols-outlined');
        const originalText = textSpan ? textSpan.innerText : '';
        const originalIcon = iconSpan ? iconSpan.innerText : '';

        if (textSpan) textSpan.innerText = 'Copied!';
        if (iconSpan) iconSpan.innerText = 'done';
        
        btnElement.classList.add('bg-emerald-600', 'text-white');

        setTimeout(() => {
          if (textSpan) textSpan.innerText = originalText;
          if (iconSpan) iconSpan.innerText = originalIcon;
          btnElement.classList.remove('bg-emerald-600', 'text-white');
        }, 1800);
      });
    }



